//@version=5
strategy("Sample SMA Cross", overlay=true, initial_capital=10000)

fast_len = input.int(10, "Fast MA")
slow_len = input.int(30, "Slow MA")

fast_ma = ta.sma(close, fast_len)
slow_ma = ta.sma(close, slow_len)

long_condition = ta.crossover(fast_ma, slow_ma)
short_condition = ta.crossunder(fast_ma, slow_ma)

if long_condition
    strategy.entry("Long", strategy.long)

if short_condition
    strategy.close("Long")

plot(fast_ma, color=color.teal)
plot(slow_ma, color=color.orange)
